# EditorConfig — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Java is formatted by google-java-format (2 spaces); XML/YAML/JSON/TS follow the same width
[*.{java,xml,yml,yaml,json,ts,html,scss,css,js,mjs,cjs,sql,sh,toml,properties}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{cmd,bat}]
end_of_line = crlf

[Makefile]
indent_style = tab
